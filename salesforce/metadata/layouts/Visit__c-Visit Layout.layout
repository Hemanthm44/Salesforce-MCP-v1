<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Information</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Name</field></layoutItems>
            <layoutItems><behavior>Required</behavior><field>Patient__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Doctor__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Condition__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Visit_Date__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Visit_Type__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Status__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Department__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>A&amp;E Journey</label>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Arrival_Mode__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Triage_Category__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Arrival_Time__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Seen_Time__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Handoff_To__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Handoff_Time__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Discharge_Time__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Disposition__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Performance and Feedback</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Wait_Minutes__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Hours_In_Department__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Breached_4hr__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Satisfaction_Score__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Observations</label>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Systolic_BP__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Diastolic_BP__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>HbA1c__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Summary</label>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Summary__c</field></layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>false</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>CreatedById</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>LastModifiedById</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <relatedLists>
        <fields>NAME</fields>
        <fields>Test_Name__c</fields>
        <fields>Value__c</fields>
        <fields>Unit__c</fields>
        <fields>Flag__c</fields>
        <fields>Result_Time__c</fields>
        <relatedList>Lab_Result__c.Visit__c</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>CASES.CASE_NUMBER</fields>
        <fields>CASES.SUBJECT</fields>
        <fields>CASES.STATUS</fields>
        <fields>Feedback_Category__c</fields>
        <relatedList>Case.Visit__c</relatedList>
    </relatedLists>
</Layout>